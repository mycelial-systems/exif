{
  "name": "@substrate-system/exif",
  "type": "module",
  "version": "1.0.11",
  "description": "Read and write exif data.",
  "main": "dist/index.js",
  "files": [
    "./dist/*"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": "./dist/node.js",
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "scripts": {
    "lint": "eslint \"./**/*.{ts,js}\"",
    "test": "npm run test:node && npm run test:browser",
    "test:node": "esbuild ./test/index.ts --bundle --platform=node --format=esm | node",
    "test:browser": "esbuild ./test/browser.ts --bundle --loader:.jpg=binary | tapout",
    "build-cjs": "esbuild $(find src/** -maxdepth 1 -name '*.ts' ! -name 'node.ts') --format=cjs --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --out-extension:.js=.cjs --sourcemap",
    "build-cjs:min": "esbuild $(find src/** -maxdepth 1 -name '*.ts' ! -name 'node.ts') --format=cjs --minify --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --out-extension:.js=.min.cjs --sourcemap",
    "build-esm": "esbuild $(find src/** -maxdepth 1 -name '*.ts' ! -name 'node.ts') --format=esm --metafile=dist/meta.json --keep-names --tsconfig=tsconfig.build.json --outdir=./dist --sourcemap && tsc --emitDeclarationOnly --project tsconfig.build.json --outDir dist",
    "build-esm:min": "esbuild $(find src/** -maxdepth 1 -name '*.ts' ! -name 'node.ts') --format=esm --keep-names --bundle --tsconfig=tsconfig.build.json --minify --out-extension:.js=.min.js --outdir=./dist --sourcemap",
    "build-example": "mkdir -p ./public && rm -rf ./public/* && VITE_DEBUG_MODE=staging vite --mode staging --base=\"/exif\" build",
    "build-docs": "typedoc ./src/index.ts",
    "build": "mkdir -p ./dist && rm -rf ./dist/* && npm run build-cjs && npm run build-esm && npm run build-esm:min && npm run build-cjs:min && npm run build:node",
    "build:node": "esbuild ./src/node.ts --format=esm --keep-names --tsconfig=tsconfig.node.json --outdir=./dist --sourcemap && tsc --emitDeclarationOnly --project tsconfig.node.json --outDir dist",
    "start": "vite",
    "toc": "markdown-toc --maxdepth 3 -i README.md",
    "preversion": "npm run lint",
    "version": "npm run toc && auto-changelog -p --template keepachangelog --breaking-pattern 'BREAKING CHANGE:' && git add CHANGELOG.md README.md",
    "postversion": "git push --follow-tags && npm publish",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@preact/signals": "^2.5.1",
    "@substrate-system/css-normalize": "^0.0.13",
    "@substrate-system/debug": "^0.9.24",
    "@substrate-system/tapout": "^0.0.30",
    "@substrate-system/tapzero": "^0.10.15",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "auto-changelog": "^2.4.0",
    "esbuild": "^0.27.0",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "htm": "^3.1.1",
    "markdown-toc": "^1.2.0",
    "postcss-nesting": "^13.0.2",
    "preact": "^10.27.0",
    "tap-spec": "^5.0.0",
    "typedoc": "^0.28.9",
    "typescript": "^5.9.2",
    "vite": "^7.0.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/substrate-system/exif.git"
  },
  "keywords": [
    "jpeg",
    "exif",
    "metadata"
  ],
  "author": "hMatoba",
  "contributors": [
    "nichoth <nichoth@nichoth.com> (https://nichoth.com)"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/substrate-system/exif/issues"
  },
  "homepage": "https://github.com/substrate-system/exif"
}
